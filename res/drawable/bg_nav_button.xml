<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#242c3d" />
            <corners android:radius="10dp" />
            <stroke android:width="2.5dp" android:color="#ff5500" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#ff5500" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="#ff6e1a" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#161a24" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#252c3b" />
        </shape>
    </item>
</selector>
