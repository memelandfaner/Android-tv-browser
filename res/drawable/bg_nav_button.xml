<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#243452" />
            <corners android:radius="10dp" />
            <stroke android:width="2.5dp" android:color="#00e5ff" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#0080a8" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="#00e5ff" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#141c2e" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#24334d" />
        </shape>
    </item>
</selector>
