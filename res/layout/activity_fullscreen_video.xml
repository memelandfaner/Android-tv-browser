<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/videoRootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- Native Hardware Video View -->
    <VideoView
        android:id="@+id/nativeVideoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        android:focusable="false" />

    <!-- Center Buffering / Loading Indicator -->
    <ProgressBar
        android:id="@+id/videoBufferingSpinner"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_centerInParent="true"
        android:indeterminate="true"
        android:visibility="visible" />

    <!-- Top Overlay HUD (Title & Indicator) -->
    <LinearLayout
        android:id="@+id/topHudContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="#99000000"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="14dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/txtVideoTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Predvajalnik Videa"
            android:textColor="#f8fafc"
            android:textSize="18sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tipka NAZAJ za izhod"
            android:textColor="#94a3b8"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Bottom Overlay HUD (Playback Controls & Timeline) -->
    <LinearLayout
        android:id="@+id/bottomHudContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#B3000000"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtCurrentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#38bdf8"
                android:textSize="15sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/videoSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="16dp"
                android:max="1000"
                android:focusable="false" />

            <TextView
                android:id="@+id/txtTotalDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#94a3b8"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/txtPlaybackHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OK: Pavza / Predvajaj  •  ◄ -10s  •  ► +10s"
                android:textColor="#cbd5e1"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Center Play / Pause Indicator Toast -->
    <TextView
        android:id="@+id/centerFeedbackToast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="#CC0F172A"
        android:textColor="#00e5ff"
        android:textSize="22sp"
        android:textStyle="bold"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:visibility="gone" />

</RelativeLayout>
