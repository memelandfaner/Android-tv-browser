<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- Top Header Container (Slim Glassmorphic TV Design) -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="vertical"
        android:background="@drawable/bg_nav_bar"
        android:elevation="12dp">

        <!-- Main Navigation Toolbar -->
        <LinearLayout
            android:id="@+id/navBar"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_nav_button"
                android:text="◀"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:nextFocusDown="@id/btnAddTab"
                android:focusable="true" />

            <Button
                android:id="@+id/btnForward"
                android:layout_width="40dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_nav_button"
                android:text="▶"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:nextFocusDown="@id/btnAddTab"
                android:focusable="true" />

            <Button
                android:id="@+id/btnHome"
                android:layout_width="40dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_nav_button"
                android:text="🏠"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:nextFocusDown="@id/editUrl"
                android:focusable="true" />

            <!-- Omnibox URL / Search input -->
            <EditText
                android:id="@+id/editUrl"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_omnibox"
                android:hint="@string/url_hint"
                android:textColorHint="@color/text_secondary"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:imeOptions="actionGo"
                android:inputType="textUri|textWebEditText"
                android:nextFocusDown="@id/tabsScrollView"
                android:focusable="true" />

            <Button
                android:id="@+id/btnGo"
                android:layout_width="52dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_nav_button"
                android:text="Išči"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:focusable="true" />

            <Button
                android:id="@+id/btnStarBookmark"
                android:layout_width="40dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_nav_button"
                android:text="⭐"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:focusable="true" />

            <Button
                android:id="@+id/btnNavBookmarks"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:paddingHorizontal="12dp"
                android:background="@drawable/bg_nav_button"
                android:text="Zaznamki"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:focusable="true" />

            <Button
                android:id="@+id/btnNavDownloads"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:paddingHorizontal="12dp"
                android:background="@drawable/bg_nav_button"
                android:text="Prenosi"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:focusable="true" />

            <Button
                android:id="@+id/btnNavHistory"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:paddingHorizontal="12dp"
                android:background="@drawable/bg_nav_button"
                android:text="Zgodovina"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:focusable="true" />

            <Button
                android:id="@+id/btnNavSettings"
                android:layout_width="40dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_nav_button"
                android:text="⚙️"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:focusable="true" />
        </LinearLayout>

        <!-- Multi-Tab & Fast Links Bar (Compact 34dp) -->
        <LinearLayout
            android:id="@+id/tabsBarContainer"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="#0f172a"
            android:paddingHorizontal="14dp">

            <Button
                android:id="@+id/btnAddTab"
                android:layout_width="32dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_nav_button"
                android:text="➕"
                android:textColor="@color/accent_cyan"
                android:textSize="13sp"
                android:focusable="true" />

            <HorizontalScrollView
                android:id="@+id/tabsScrollView"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/tabsLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Quick Links -->
            <LinearLayout
                android:id="@+id/quickLinksBar"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnQuickSmartTube"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:paddingHorizontal="8dp"
                    android:background="@drawable/bg_ai_pill"
                    android:text="📺 SmartTube"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:layout_marginStart="6dp"
                    android:focusable="true" />

                <Button
                    android:id="@+id/btnQuickGithub"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:paddingHorizontal="8dp"
                    android:background="@drawable/bg_ai_pill"
                    android:text="🐙 GitHub"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:layout_marginStart="6dp"
                    android:focusable="true" />

                <Button
                    android:id="@+id/btnQuickTmdb"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:paddingHorizontal="8dp"
                    android:background="@drawable/bg_ai_pill"
                    android:text="🍿 TMDB"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:layout_marginStart="6dp"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/pageProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_below="@id/headerContainer"
        android:progressDrawable="@drawable/bg_omnibox"
        android:visibility="gone"
        android:elevation="14dp" />

    <!-- Main Content Area -->
    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerContainer">

        <!-- Container for Multi-Tab WebViews -->
        <FrameLayout
            android:id="@+id/webViewContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <!-- Bookmarks Panel -->
        <ScrollView
            android:id="@+id/bookmarksPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_primary"
            android:padding="24dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="⭐ Zaznamki"
                        android:textColor="@color/accent_cyan"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnAddCustomBookmark"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:paddingHorizontal="16dp"
                        android:background="@drawable/bg_nav_button"
                        android:text="@string/btn_add_bookmark"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Dynamic Grid Container -->
                <GridLayout
                    android:id="@+id/bookmarksGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:useDefaultMargins="true"
                    android:alignmentMode="alignMargins" />

            </LinearLayout>
        </ScrollView>

        <!-- Downloads Panel -->
        <ScrollView
            android:id="@+id/downloadsPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_primary"
            android:padding="24dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⬇️ Upravljalnik Prenosov"
                    android:textColor="@color/accent_cyan"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:id="@+id/downloadsListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/textNoDownloads"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="40dp"
                    android:text="Ni prenesenih datotek."
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>

        <!-- History Panel -->
        <ScrollView
            android:id="@+id/historyPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_primary"
            android:padding="24dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🕒 Zgodovina Brskanja"
                        android:textColor="@color/accent_cyan"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnClearHistory"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:paddingHorizontal="14dp"
                        android:background="@drawable/bg_nav_button"
                        android:text="🗑️ Počisti Zgodovino"
                        android:textColor="#ef4444"
                        android:textSize="12sp"
                        android:focusable="true" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/historyListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/textNoHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="40dp"
                    android:text="Zgodovina je prazna."
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>

        <!-- Settings Panel -->
        <ScrollView
            android:id="@+id/settingsPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_primary"
            android:padding="24dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚙️ Nastavitve TV Brskalnika"
                    android:textColor="@color/accent_cyan"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="20dp" />

                <!-- AdBlock Settings Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🛡️ Vgrajeni AdBlocker &amp; Top-Frame Lock"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Blokira 1500+ oglasnih in stavnih domen ter preprečuje preusmeritve."
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnToggleAdblock"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:paddingHorizontal="16dp"
                        android:background="@drawable/bg_nav_button"
                        android:text="VKLOPLJENO"
                        android:textColor="@color/accent_cyan"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Anti-Anti-Adblock Toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚔️ Anti-Anti-AdBlock Modul"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nevtralizira FuckAdBlock in lažne preglede oglasov s takojšnjim JS spoofingom."
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnToggleAntiAnti"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:paddingHorizontal="16dp"
                        android:background="@drawable/bg_nav_button"
                        android:text="VKLOPLJENO"
                        android:textColor="@color/accent_cyan"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Cosmetic Filtering Toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎨 Kozmetično Filtriranje (Cosmetic Hiding)"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Skrije prazne okvirje oglasov, pasice in pojavna okna s CSS pravili."
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnToggleCosmetic"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:paddingHorizontal="16dp"
                        android:background="@drawable/bg_nav_button"
                        android:text="VKLOPLJENO"
                        android:textColor="@color/accent_cyan"
                        android:focusable="true" />
                </LinearLayout>

                <!-- User-Agent Selection -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🖥️ Način Prikaza (User-Agent)"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textCurrentUa"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Trenutno: Android TV (Optimizirano)"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnSwitchUa"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:paddingHorizontal="16dp"
                        android:background="@drawable/bg_nav_button"
                        android:text="Zamenjaj"
                        android:textColor="@color/text_primary"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Search Engine Selection -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔍 Privzeti Iskalnik"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textCurrentEngine"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Trenutno: Google Iskanje"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnSwitchEngine"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:paddingHorizontal="16dp"
                        android:background="@drawable/bg_nav_button"
                        android:text="Zamenjaj"
                        android:textColor="@color/text_primary"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Cookie Privacy Level Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🍪 Nadzor Piškotkov &amp; Sledenja"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textCurrentCookiePrivacy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Trenutno: Običajno (Blokada 3rd-party sledilcev)"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnSwitchCookiePrivacy"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:paddingHorizontal="16dp"
                        android:background="@drawable/bg_nav_button"
                        android:text="Zamenjaj"
                        android:textColor="@color/accent_cyan"
                        android:focusable="true" />
                </LinearLayout>

                <!-- YouTube Freedom & SponsorBlock Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚡ YouTube Brez Kletke (SponsorBlock)"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Avtomatski preskok sponzorjev, vračilo Dislike števcev in skritje nadležnih oglasnih pasic."
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnToggleYouTubeFreedom"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:paddingHorizontal="16dp"
                        android:background="@drawable/bg_nav_button"
                        android:text="VKLOPLJENO"
                        android:textColor="@color/accent_cyan"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Private DNS & Anti-Censorship Guide Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:orientation="vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌐 Svobodni DNS &amp; Zaščita Pred Cenzuro"
                        android:textColor="@color/accent_cyan"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ISP operaterji pogosto cenzurirajo spletne strani. V Android TV nastavitvah vklopite 'Private DNS':\n• dns.quad9.net (Quad9 - Brez cenzure &amp; zaščita)\n• one.one.one.one (Cloudflare)\n• dns.adguard-dns.com (Omrežna blokada oglasov)"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnOpenDnsSettings"
                            android:layout_width="wrap_content"
                            android:layout_height="42dp"
                            android:paddingHorizontal="14dp"
                            android:background="@drawable/bg_nav_button"
                            android:text="⚙️ Android DNS Nastavitve"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:layout_marginEnd="8dp"
                            android:focusable="true" />

                        <Button
                            android:id="@+id/btnTestDnsCensorship"
                            android:layout_width="wrap_content"
                            android:layout_height="42dp"
                            android:paddingHorizontal="14dp"
                            android:background="@drawable/bg_nav_button"
                            android:text="🔍 Testiraj Cenzuro"
                            android:textColor="@color/accent_cyan"
                            android:textSize="12sp"
                            android:focusable="true" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Clear Cache -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🧹 Predpomnilnik &amp; Piškotki"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Počisti zgodovino brskanja in začasne podatke."
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnClearCache"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:paddingHorizontal="16dp"
                        android:background="@drawable/bg_nav_button"
                        android:text="Počisti"
                        android:textColor="@color/accent_red"
                        android:focusable="true" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- Custom View Container for Fullscreen Video -->
        <FrameLayout
            android:id="@+id/customViewContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000"
            android:visibility="gone"
            android:elevation="20dp" />

        <!-- Virtual Cursor Overlay -->
        <com.example.tvbrowser.CursorOverlay
            android:id="@+id/cursorOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:elevation="30dp" />

        <!-- Voice Listening TV HUD Overlay -->
        <LinearLayout
            android:id="@+id/voiceListeningOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#d8000000"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            android:elevation="40dp">

            <LinearLayout
                android:layout_width="520dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp">

                <TextView
                    android:id="@+id/textVoiceMicIcon"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_nav_button"
                    android:gravity="center"
                    android:text="🎤"
                    android:textSize="40sp" />

                <TextView
                    android:id="@+id/textVoiceStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Poslušam... Govorite zdaj!"
                    android:textColor="@color/accent_cyan"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textVoicePrompt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Npr: 'Odpri YouTube', 'Poišči Spider-Man', 'StreamNexus'..."
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnCancelVoice"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginTop="24dp"
                    android:paddingHorizontal="24dp"
                    android:background="@drawable/bg_nav_button"
                    android:text="Prekliči"
                    android:textColor="@color/text_primary"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>

    </FrameLayout>
</RelativeLayout>
